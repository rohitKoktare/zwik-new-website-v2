# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local (see .gitignore).
#
#   cp .env.example .env.local
#
# All four are required. Confirm with `npm run verify:setup`.
# ---------------------------------------------------------------------------

# Supabase — public. Safe to expose to the browser; both ship in the JS bundle.
# Dashboard -> Project Settings -> API -> Project URL / anon public key.
#
# The subdomain of the URL is your project ref, which `supabase link` wants:
#   https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
#
# Required for two things that cannot work without it:
#   - the admin area's audit trail (audit_logs is append-only from trusted
#     server code and has no INSERT policy)
#   - order capture (customers/orders have no client-writable policy at all)
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used for canonical URLs, sitemap and Open Graph.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
